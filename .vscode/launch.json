{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Start AI Pool Coordinator",
      "type": "python",
      "request": "launch",
      "program": "-m",
      "args": [
        "uvicorn",
        "src.coordinator:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
